{
  "name": "@hyjk2000/homebridge-bravia",
  "displayName": "Sony BRAVIA",
  "version": "0.0.4",
  "description": "Homebridge television platform for Sony BRAVIA TVs",
  "keywords": [
    "bravia",
    "homebridge-plugin",
    "sony",
    "supports-hap",
    "television"
  ],
  "license": "MIT",
  "author": "James Shi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyjk2000/bravia.git",
    "directory": "packages/homebridge"
  },
  "homepage": "https://github.com/hyjk2000/bravia/tree/master/packages/homebridge#readme",
  "bugs": {
    "url": "https://github.com/hyjk2000/bravia/issues"
  },
  "files": [
    "dist",
    "config.schema.json"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
